---
import { Font } from "astro:assets";
import "../styles/global.css";
import { DEFAULT_DESCRIPTION } from "../utils/site";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  alternateMarkdown?: string;
  type?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /** schema.org data; each object becomes its own JSON-LD script. */
  jsonLd?: object | object[];
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical,
  alternateMarkdown,
  type = "website",
  author,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon-precomposed" href="/apple-touch-icon-precomposed.png" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="LLM-friendly summary"
    />
    <link rel="ard" href="/.well-known/ard.json" />

    {
      alternateMarkdown && (
        <link
          rel="alternate"
          type="text/markdown"
          href={alternateMarkdown}
          title="Markdown version"
        />
      )
    }
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://clairvoyance.fyi/og.png" />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    {author && <meta name="author" content={author} />}
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      [jsonLd ?? []].flat().map((data) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
        />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://clairvoyance.fyi/og.png" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main id="main-content">
      <slot />
    </main>

    <script>
      import { registerWebMcpTools } from "../utils/webmcp";

      registerWebMcpTools({
        // The proposal moved the API from navigator to document; prefer
        // document and keep navigator as the fallback.
        modelContext: document.modelContext ?? navigator.modelContext,
        fetch: fetch.bind(window),
        origin: location.origin,
      });
    </script>

    <script>
      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) e.target.classList.add("vis");
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll(".reveal").forEach((el) => obs.observe(el));
    </script>
  </body>
</html>
