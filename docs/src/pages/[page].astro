---
import Layout from "../layouts/Layout.astro";
import CrystalBall from "../assets/crystal-ball.svg";
import { getInfoPages, type InfoPage } from "../utils/info-pages";
import { SITE_URL } from "../utils/site";

export function getStaticPaths() {
  return getInfoPages().map((page) => ({ params: { page: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: InfoPage };
---

<Layout
  title={`${page.title} — Clairvoyance`}
  description={page.description}
  canonical={`${SITE_URL}/${page.slug}`}
>
  <article class="info-page">
    <nav class="info-nav">
      <a href="/" class="brand-link">
        <CrystalBall width="20" height="20" />
        <span>Clairvoyance</span>
      </a>
    </nav>

    <h1>{page.title}</h1>
    {page.updated && <p class="updated">Last updated: {page.updated}</p>}

    <Fragment set:html={page.html} />
  </article>
</Layout>

<style>
  .info-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem clamp(1.5rem, 5vw, 3rem) 4rem;
    background: oklch(0.17 0.05 290);
    border-left: 1px solid oklch(1 0 0 / 0.03);
    border-right: 1px solid oklch(1 0 0 / 0.03);
    min-height: 100vh;
  }

  .info-nav {
    display: flex;
    align-items: center;
    padding: 1.5rem 0 2.5rem;
    border-bottom: 1px solid oklch(1 0 0 / 0.06);
    margin-bottom: 2.5rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: none;
    color: var(--text);
    transition: opacity 0.2s;

    & :global(svg) {
      width: 36px;
      height: 36px;
      filter: drop-shadow(0 0 12px oklch(0.75 0.12 75 / 0.3));
    }

    & span {
      font-family: var(--font-display);
      font-size: 1.7rem;
    }

    &:hover {
      opacity: 0.8;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin-bottom: 0.5rem;
  }

  .info-page .updated {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.03em;
    margin-bottom: 2.5rem;
  }

  .info-page :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 0.6rem;
    color: var(--text);
  }

  .info-page :global(p) {
    font-weight: 300;
    font-size: 1rem;
    color: var(--text);
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }

  .info-page :global(ul) {
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .info-page :global(li) {
    font-weight: 300;
    font-size: 1rem;
    color: var(--text);
    line-height: 1.75;
    margin-bottom: 0.35rem;
  }
</style>
