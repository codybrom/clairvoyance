---
import CrystalBall from "../assets/crystal-ball.svg";
import AgentLogo from "./AgentLogo.astro";
import AgentSetupButton from "./AgentSetupButton.astro";
import { getInstallGuide } from "../utils/install";

// The agents most people install for; everything else is behind "More".
const FEATURED = ["claude-code", "codex", "cursor", "opencode", "antigravity", "skillssh"];
const platforms = getInstallGuide().platforms;
const chips = FEATURED.map((id) => platforms.find((p) => p.id === id)!);
---

<div class="hero">
  <div class="orb" aria-hidden="true">
    <CrystalBall width="80" height="80" />
  </div>
  <h1>Clairvoyance</h1>
  <p class="tagline">ESP for AI Coding</p>
  <p class="hero-sub">Good software isn't written. It's designed.</p>
  <p class="hero-sub2">
    Open your agent's third eye and see what it's been missing.
  </p>
  <AgentSetupButton />
  <nav class="install-chips" aria-label="Install Clairvoyance">
    <p class="install-label">Or install manually for</p>
    <div class="chip-row">
      {
        chips.map((p) => (
          <a href={`/install#${p.id}`} class="chip">
            <AgentLogo id={p.id} />
            {p.name}
          </a>
        ))
      }
      <a href="/install" class="chip chip-more">More&hellip;</a>
    </div>
  </nav>
</div>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    position: relative;

    &::before {
      content: "";
      position: absolute;
      width: 700px;
      height: 700px;
      border-radius: 50%;
      background: radial-gradient(
        circle,
        oklch(0.75 0.12 75 / 0.18) 0%,
        oklch(0.5 0.08 290 / 0.08) 40%,
        transparent 70%
      );
      top: 50%;
      left: 50%;
      translate: -50% -55%;
      pointer-events: none;
    }
  }

  .orb {
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
    animation: breathe 3.5s ease-in-out infinite;
    filter: drop-shadow(0 0 60px oklch(0.75 0.12 75 / 0.45));
  }

  .orb :global(svg) {
    width: 5rem;
    height: 5rem;
    display: block;
  }

  @keyframes breathe {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.12;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(4rem, 10vw, 7rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .tagline {
    font-family: var(--font-code);
    font-weight: 300;
    font-size: clamp(0.9rem, 2vw, 1.15rem);
    color: var(--gold);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }

  .hero-sub,
  .hero-sub2 {
    font-weight: 200;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    color: var(--text-mid);
    max-width: 640px;
    line-height: 1.65;
  }

  .hero-sub {
    margin-bottom: 0;
  }

  .hero-sub2 {
    margin-bottom: 3.5rem;
  }

  .install-chips {
    margin-top: 2.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    position: relative;
    z-index: 1;
    max-width: 600px;
  }

  .install-label {
    font-family: var(--font-code);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--text);
    background: var(--surface);
    border: 1px solid oklch(0.75 0.12 75 / 0.18);
    border-radius: 999px;
    padding: 0.55rem 1.15rem;
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      color 0.3s;

    &:hover {
      color: var(--gold);
      border-color: oklch(0.75 0.12 75 / 0.45);
      box-shadow: 0 0 40px oklch(0.75 0.12 75 / 0.1);
    }
  }

  .chip-more {
    color: var(--gold);
    background: none;
  }
</style>
