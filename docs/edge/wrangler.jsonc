// Markdown content negotiation in front of the GitHub Pages origin.
// See worker.ts. Cloudflare Workers Builds deploys it on every push to main
// (root directory docs/edge).
{
  "name": "clairvoyance-edge",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "clairvoyance.fyi/*",
      "zone_name": "clairvoyance.fyi"
    }
  ]
}